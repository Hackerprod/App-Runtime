<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AndroidRuntime.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\RuntimeProbe.apk" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Fixtures\RuntimeProbe.apk')" />
    <None Include="Fixtures\UnimplementedApiProbe.apk" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Fixtures\UnimplementedApiProbe.apk')" />
    <None Include="Fixtures\WideProbe.apk" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Fixtures\WideProbe.apk')" />
    <None Include="Fixtures\WideClockProbe.apk" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Fixtures\WideClockProbe.apk')" />
    <None Include="Fixtures\ExceptionProbe.apk" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Fixtures\ExceptionProbe.apk')" />
    <None Include="Fixtures\ServicesProbe.apk" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Fixtures\ServicesProbe.apk')" />
    <None Include="Fixtures\ServicesProbeMissingPermission.apk" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Fixtures\ServicesProbeMissingPermission.apk')" />
    <None Include="Fixtures\UiProbe.apk" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Fixtures\UiProbe.apk')" />
  </ItemGroup>
</Project>
